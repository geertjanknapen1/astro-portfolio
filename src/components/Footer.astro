---
import { internalPath } from '../utils/paths';

const year = new Date().getFullYear();

import { execSync } from 'node:child_process';

const lastContentUpdate = execSync(
  [
    'git log -1 --format=%cI --',
    'src/content',
    'src/pages',
    'public/images',
  ].join(' '),
  { encoding: 'utf-8' }
).trim();

const formattedLastContentUpdate = new Intl.DateTimeFormat('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(lastContentUpdate));
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-title">Tot zover de voorkant.</p>
      <p>
        Met aandacht en ❤️ gebouwd door Geert-Jan.<br/>
        <span class="last-updated">Laatst bijgewerkt · {formattedLastContentUpdate}</span>
      </p>
    </div>

    <div class="footer-meta">
      <a href={internalPath('ai-gebruik-en-werkwijze/')}>
        AI & mijn werkwijze
      </a>

      <span>© {year} Geert-Jan Knapen</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
  }

  .footer-title {
    margin-bottom: 0.25rem;
    font-weight: 700;
  }

  p,
  span,
  a {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  p:last-child {
    margin-bottom: 0;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.5rem;
  }

  .footer-meta a {
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 180ms ease;
  }

  .footer-meta a:hover {
    color: var(--color-brick);
  }

  .last-updated {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  @media (max-width: 600px) {
    .footer-inner {
      align-items: start;
      flex-direction: column;
    }

    .footer-meta {
      justify-content: flex-start;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-meta a {
      transition: none;
    }
  }
</style>
