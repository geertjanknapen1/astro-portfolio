---
import ArrowIcon from './ArrowIcon.astro';
import ProjectImage from './ProjectImage.astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  number?: string;
  coverImage?: string | undefined;
}

const {
  title,
  description,
  tags,
  href,
  number,
  coverImage,
} = Astro.props;
---

<article class="project-card">
  <a href={href}>
    <div class="project-header">
      {
        number && (
          <span class="project-number">{number}</span>
        )
      }

      <span class="project-arrow">
        <ArrowIcon size={26} />
      </span>
    </div>

    <div class="project-main">
      <div class="project-content">
        <h3>{title}</h3>

        <p>{description}</p>

        <ul aria-label={`Tech stack van ${title}`}>
          {
            tags.map((tag) => (
              <li>{tag}</li>
            ))
          }
        </ul>
      </div>

      {
        coverImage && (
          <div class="project-thumbnail">
            <ProjectImage
              src={coverImage}
              alt=""
              variant="thumbnail"
            />
          </div>
        )
      }
    </div>
  </a>
</article>

<style>
  .project-card {
    border-top: 1px solid var(--color-border);
  }

  .project-card > a {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-block: 2.5rem;
    transition:
      padding 180ms ease,
      color 180ms ease;
  }

  .project-card > a:hover {
    padding-inline: 1rem;
    color: inherit;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
  }

  .project-number {
    color: var(--color-brick);
    font-family: var(--font-accent);
    font-size: 1.5rem;
  }

  .project-arrow {
    display: none;
    color: var(--color-brick);
  }

  .project-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 4rem);
    min-width: 0;
  }

  .project-content {
    flex: 1;
    min-width: 0;
  }

  h3 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  p {
    max-width: 650px;
    margin-bottom: 1.5rem;
    color: var(--color-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .project-thumbnail {
    flex: 0 0 clamp(180px, 30%, 320px);
    min-width: 0;
  }

  @media (max-width: 850px) {
    .project-main {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
    }

    .project-thumbnail {
      width: min(100%, 420px);
      flex: none;
    }
  }

  @media (max-width: 650px) {
    .project-card > a {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .project-header {
      align-items: center;
    }

    .project-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .project-card > a:hover {
      padding-inline: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card > a {
      transition: none;
    }
  }
</style>
