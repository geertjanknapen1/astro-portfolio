---
interface Props {
    title: string;
    description: string;
    tags: string[];
    href: string;
    number?: string;
}

const {
  title,
  description,
  tags,
  href,
  number,
} = Astro.props;
---

<article class="project-card">
    <a href={href}>
        <div class="project-header">
            {number && <span class="project-number">{number}</span>}

            <span class="project-arrow" aria-hidden="true">↗</span>
        </div>

        <div class="project-content">
            <h3>{title}</h3>

            <p>{description}</p>
            <ul aria-label={`Tech stack van ${title}`}>
                {tags.map((tag) => (
                    <li>{tag}</li>
                ))}
            </ul>
        </div>
    </a>
</article>

<style>
  .project-card {
    border-top: 1px solid var(--color-border);
  }

  .project-card > a {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-block: 2.5rem;
    transition:
      padding 180ms ease,
      color 180ms ease;
  }

  .project-card > a:hover {
    padding-inline: 1rem;
    color: inherit;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
  }

  .project-number {
    color: var(--color-brick);
    font-family: var(--font-accent);
    font-size: 1.5rem;
  }

  .project-arrow {
    display: none;
  }

  h3 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  p {
    max-width: 650px;
    margin-bottom: 1.5rem;
    color: var(--color-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  @media (max-width: 650px) {
    .project-card > a {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .project-arrow {
      display: block;
    }

    .project-card > a:hover {
      padding-inline: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card > a {
      transition: none;
    }
  }
</style>