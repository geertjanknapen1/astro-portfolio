---
import { internalPath } from '../utils/paths';
import ArrowIcon from './ArrowIcon.astro';

const currentPath = Astro.url.pathname;

const navigation = [
  { label: 'Over mij', href: internalPath('over-mij/') },
  { label: 'Werk', href: internalPath('werk/') },
  { label: 'Projecten', href: internalPath('projecten/') },
  { label: 'Contact', href: internalPath('contact/') },
];

const normalizePath = (path: string): string =>
  path.endsWith('/') ? path : `${path}/`;

const isActive = (href: string): boolean => {
  const current = normalizePath(currentPath);
  const target = normalizePath(href);

  return current === target || current.startsWith(target);
};

const isCurrentPage = (href: string): boolean =>
  normalizePath(currentPath) === normalizePath(href);

const homePath = internalPath();
const isHome = isCurrentPage(homePath);
---

<a class="skip-link" href="#main-content">
  Direct naar inhoud
</a>

<header class="site-header">
  <div class="container header-inner">
    <a
      class:list={['logo', { 'logo--active': isHome }]}
      href={homePath}
      aria-label="Geert-Jan Knapen, naar homepage"
      aria-current={isHome ? 'page' : undefined}
    >
      GJK<span>.</span>
    </a>

    <nav
      class="desktop-navigation"
      aria-label="Hoofdnavigatie"
    >
      <ul>
        {
          navigation.map((item) => {
            const active = isActive(item.href);
            const current = isCurrentPage(item.href);

            return (
              <li>
                <a
                  href={item.href}
                  class:list={{ 'nav-link--active': active }}
                  aria-current={
                    current ? 'page' : undefined
                  }
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="Thema: automatisch. Klik voor licht thema."
      title="Thema wijzigen"
    >
      <span class="theme-symbol" aria-hidden="true">
        ◐
      </span>
      <span id="theme-label">Auto</span>
    </button>

    <details
      class="mobile-navigation"
      id="mobile-menu"
    >
      <summary class="menu-toggle">
        <span class="menu-label">Menu</span>

        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </summary>

      <nav
        class="mobile-menu-panel"
        aria-label="Mobiele hoofdnavigatie"
      >
        <ul>
          {
            navigation.map((item, index) => {
              const active = isActive(item.href);
              const current = isCurrentPage(item.href);

              return (
                <li>
                  <a
                    href={item.href}
                    class:list={{
                      'mobile-link--active': active,
                    }}
                    aria-current={
                      current ? 'page' : undefined
                    }
                  >
                    <span class="mobile-link-number">
                      {String(index + 1).padStart(2, '0')}
                    </span>

                    <span class="mobile-link-label">
                      {item.label}
                    </span>

                    <span
                      class="mobile-link-arrow"
                      aria-hidden="true"
                    >
                      <ArrowIcon size={22} />
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <p class="mobile-menu-footer">
          Achter de schermen.
        </p>
      </nav>
    </details>
  </div>
</header>

<script>
  type ThemePreference =
    | 'auto'
    | 'light'
    | 'dark';

  const storageKey = 'portfolio-theme';
  const root = document.documentElement;

  const themeToggle =
    document.querySelector<HTMLButtonElement>(
      '#theme-toggle'
    );

  const themeLabel =
    document.querySelector<HTMLElement>(
      '#theme-label'
    );

  const systemTheme = window.matchMedia(
    '(prefers-color-scheme: dark)'
  );

  const themeNames: Record<
    ThemePreference,
    string
  > = {
    auto: 'Auto',
    light: 'Licht',
    dark: 'Donker',
  };

  const nextTheme: Record<
    ThemePreference,
    ThemePreference
  > = {
    auto: 'light',
    light: 'dark',
    dark: 'auto',
  };

  function getPreference(): ThemePreference {
    const value = root.dataset.themePreference;

    if (
      value === 'light' ||
      value === 'dark'
    ) {
      return value;
    }

    return 'auto';
  }

  function applyTheme(
    preference: ThemePreference
  ): void {
    const effectiveTheme =
      preference === 'auto'
        ? systemTheme.matches
          ? 'dark'
          : 'light'
        : preference;

    root.dataset.theme = effectiveTheme;
    root.dataset.themePreference = preference;

    if (themeLabel) {
      themeLabel.textContent =
        themeNames[preference];
    }

    if (themeToggle) {
      const next = nextTheme[preference];

      themeToggle.setAttribute(
        'aria-label',
        `Thema: ${
          preference === 'auto'
            ? 'automatisch'
            : preference === 'light'
              ? 'licht'
              : 'donker'
        }. Klik voor ${
          next === 'auto'
            ? 'automatisch thema'
            : next === 'light'
              ? 'licht thema'
              : 'donker thema'
        }.`
      );
    }

    document
      .querySelector<HTMLMetaElement>(
        'meta[name="theme-color"]'
      )
      ?.setAttribute(
        'content',
        effectiveTheme === 'dark'
          ? '#1c1815'
          : '#f7f4ee'
      );
  }

  applyTheme(getPreference());

  themeToggle?.addEventListener(
    'click',
    () => {
      const preference =
        nextTheme[getPreference()];

      try {
        if (preference === 'auto') {
          localStorage.removeItem(storageKey);
        } else {
          localStorage.setItem(
            storageKey,
            preference
          );
        }
      } catch {
        // De keuze blijft werken tijdens dit bezoek.
      }

      applyTheme(preference);
    }
  );

  systemTheme.addEventListener(
    'change',
    () => {
      if (getPreference() === 'auto') {
        applyTheme('auto');
      }
    }
  );

  const mobileMenu =
    document.querySelector<HTMLDetailsElement>(
      '#mobile-menu'
    );

  if (mobileMenu) {
    const menuToggle =
      mobileMenu.querySelector<HTMLElement>(
        'summary'
      );

    document.addEventListener(
      'keydown',
      (event: KeyboardEvent) => {
        if (
          event.key === 'Escape' &&
          mobileMenu.open
        ) {
          mobileMenu.open = false;
          menuToggle?.focus();
        }
      }
    );

    document.addEventListener(
      'click',
      (event: MouseEvent) => {
        if (
          mobileMenu.open &&
          event.target instanceof Node &&
          !mobileMenu.contains(event.target)
        ) {
          mobileMenu.open = false;
        }
      }
    );

    const desktopBreakpoint =
      window.matchMedia('(min-width: 761px)');

    desktopBreakpoint.addEventListener(
      'change',
      (event: MediaQueryListEvent) => {
        if (event.matches) {
          if (
            mobileMenu.open &&
            mobileMenu.contains(
              document.activeElement
            )
          ) {
            mobileMenu.open = false;

            document
              .querySelector<HTMLElement>(
                '.desktop-navigation a'
              )
              ?.focus();
          } else {
            mobileMenu.open = false;
          }
        }
      }
    );
  }
</script>

<style>
  .skip-link {
    position: absolute;
    z-index: 100;
    top: -100px;
    left: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0 0 8px 8px;
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .skip-link:focus {
    top: 0;
    color: var(--color-paper);
  }

  .site-header {
    position: relative;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-paper);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 88px;
  }

  .logo {
    position: relative;
    flex-shrink: 0;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .logo span {
    color: var(--color-brick);
  }

  .logo--active::after {
    position: absolute;
    right: 0;
    bottom: -8px;
    left: 0;
    height: 2px;
    background: var(--color-brick);
    content: '';
  }

  .desktop-navigation {
    margin-left: auto;
  }

  .desktop-navigation ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem clamp(0.9rem, 2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-navigation a {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .desktop-navigation a::after {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 2px;
    background: var(--color-brick);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .desktop-navigation a:hover::after,
  .desktop-navigation a:focus-visible::after,
  .desktop-navigation a.nav-link--active::after {
    transform: scaleX(1);
  }

  .desktop-navigation a.nav-link--active {
    color: var(--color-brick);
  }

  .theme-toggle {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 80px;
    min-height: 44px;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--color-control-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--color-brick);
    color: var(--color-brick);
  }

  .theme-symbol {
    font-size: 1.1rem;
    line-height: 1;
  }

  .mobile-navigation {
    display: none;
  }

  @media (max-width: 900px) and (min-width: 761px) {
    .header-inner {
      gap: 1rem;
    }

    .desktop-navigation ul {
      gap: 0.5rem 0.8rem;
    }
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: 76px;
      gap: 0.5rem;
    }

    .desktop-navigation {
      display: none;
    }

    .theme-toggle {
      margin-left: auto;
    }

    .mobile-navigation {
      display: block;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.85rem;
      min-height: 44px;
      padding: 0.65rem 1rem;
      border: 1px solid var(--color-control-border);
      border-radius: 25px;
      background: transparent;
      color: var(--color-ink);
      font-size: 0.875rem;
      font-weight: 700;
      cursor: pointer;
      list-style: none;
      user-select: none;
      transition:
        border-color 180ms ease,
        background 180ms ease,
        color 180ms ease;
    }

    .menu-toggle::-webkit-details-marker {
      display: none;
    }

    .menu-toggle::marker {
      content: '';
    }

    .menu-toggle:hover {
      border-color: var(--color-brick);
      color: var(--color-brick);
    }

    .mobile-navigation[open] .menu-toggle {
      border-color: var(--color-brick);
      background: var(--color-sand);
      color: var(--color-brick);
    }

    .menu-icon {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 24px;
      height: 24px;
    }

    .menu-icon span {
      display: block;
      width: 24px;
      height: 2px;
      background: currentColor;
      transform-origin: center;
      transition:
        transform 180ms ease,
        background 180ms ease;
    }

    .mobile-navigation[open]
    .menu-icon span:first-child {
      transform: translateY(4px) rotate(45deg);
    }

    .mobile-navigation[open]
    .menu-icon span:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }

    .mobile-menu-panel {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      padding:
        clamp(1.5rem, 5vw, 3rem)
        var(--page-padding)
        2rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-paper);
      box-shadow:
        0 18px 30px var(--color-menu-shadow);
    }

    .mobile-menu-panel ul {
      width: min(100%, var(--container-width));
      margin: 0 auto;
      padding: 0;
      list-style: none;
    }

    .mobile-menu-panel li {
      border-bottom: 1px solid var(--color-border);
    }

    .mobile-menu-panel li:first-child {
      border-top: 1px solid var(--color-border);
    }

    .mobile-menu-panel a {
      display: grid;
      grid-template-columns:
        2rem minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 1rem;
      padding-block: clamp(
        1.25rem,
        4vw,
        1.75rem
      );
      transition:
        color 180ms ease,
        padding 180ms ease;
    }

    .mobile-menu-panel a:hover {
      color: var(--color-brick);
      padding-left: 0.4rem;
    }

    .mobile-link-number {
      color: var(--color-brick);
      font-family: var(--font-accent);
      font-size: 0.9rem;
    }

    .mobile-link-label {
      font-size: clamp(
        1.75rem,
        6vw,
        2.75rem
      );
      font-weight: 700;
      letter-spacing: -0.05em;
      line-height: 1.2;
    }

    .mobile-link-arrow {
      color: var(--color-brick);
      font-size: 1.25rem;
    }

    .mobile-link--active .mobile-link-label {
      color: var(--color-brick);
    }

    .mobile-menu-footer {
      width: min(100%, var(--container-width));
      margin: 2rem auto 0;
      color: var(--color-muted);
      font-family: var(--font-accent);
      font-size: 1rem;
      font-style: italic;
    }
  }

  @media (max-width: 380px) {
    .theme-toggle {
      min-width: 68px;
      padding-inline: 0.5rem;
    }

    .menu-toggle {
      gap: 0.5rem;
      padding-inline: 0.75rem;
    }

    .mobile-menu-panel a {
      grid-template-columns:
        1.5rem minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .mobile-link-label {
      font-size: 1.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .desktop-navigation a::after,
    .menu-toggle,
    .menu-icon span,
    .mobile-menu-panel a {
      transition: none;
    }
  }
</style>
