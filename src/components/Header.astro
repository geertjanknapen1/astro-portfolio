---
const base = import.meta.env.BASE_URL;

const navigation = [
    {label: 'Over mij', href: `${base}over-mij/`},
    {label: 'Werk', href: `${base}werk/`},
    {label: 'Projecten', href: `${base}projecten/`},
    {label: 'Contact', href: `${base}contact/`},
];
---

<header class="site-header">
    <div class="container header-inner">
        <a class="logo" href={base} aria-label="Geert-Jan Knapen - Home">
            GJK<span>.</span>
        </a>

        <nav aria-label="Hoofdnavigatie">
            <ul>
                {navigation.map((item) => (
                    <li>
                        <a href={item.href}>{item.label}</a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 88px;
  }

  .logo {
    flex-shrink: 0;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.08em;
  }

  .logo span {
    color: var(--color-brick);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .header-inner {
      flex-direction: column;
      justify-content: center;
      gap: 0.5rem;
      padding-block: 1rem;
    }

    ul {
      justify-content: center;
    }

    a {
      font-size: 0.85rem;
    }
  }
</style>