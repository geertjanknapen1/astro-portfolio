---
import { internalPath } from '../utils/paths';

const currentPath = Astro.url.pathname;

const navigation = [
    {
        label: 'Over mij',
        href: internalPath('over-mij/'),
    },
    {
        label: 'Werk',
        href: internalPath('werk/'),
    },
    {
        label: 'Projecten',
        href: internalPath('projecten/'),
    },
    {
        label: 'Contact',
        href: internalPath('contact/'),
    },
];

const normalizePath = (path: string): string => {
    return path.endsWith('/') ? path : `${path}/`;
};

const isActive = (href: string): boolean => {
    const current = normalizePath(currentPath);
    const target = normalizePath(href);

    return current === target || current.startsWith(target);
};

const isCurrentPage = (href: string): boolean => {
    return normalizePath(currentPath) === normalizePath(href);
};

const homePath = internalPath();
const isHome = isCurrentPage(homePath);
---

<a class="skip-link" href="#main-content">
    Direct naar inhoud
</a>

<header class="site-header">
    <div class="container header-inner">
        <a
            class:list={['logo', { 'logo--active': isHome }]}
            href={homePath}
            aria-label="Geert-Jan Knapen, naar homepage"
            aria-current={isHome ? 'page' : undefined}
        >
            GJK<span>.</span>
        </a>

        <nav aria-label="Hoofdnavigatie">
            <ul>
                {
                    navigation.map((item) => {
                        const active = isActive(item.href);
                        const current = isCurrentPage(item.href);

                        return (
                            <li>
                                <a
                                    href={item.href}
                                    class:list={{ 'nav-link--active': active }}
                                    aria-current={current ? 'page' : undefined}
                                >
                                    {item.label}
                                </a>
                            </li>
                        );
                    })
                }
            </ul>
        </nav>
    </div>
</header>

<style>
    .skip-link {
        position: absolute;
        z-index: 100;
        top: -100px;
        left: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 0 0 8px 8px;
        background: var(--color-ink);
        color: white;
    }

    .skip-link:focus {
        top: 0;
        color: white;
    }

    .site-header {
        border-bottom: 1px solid var(--color-border);
    }

    .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        min-height: 88px;
    }

    .logo {
        position: relative;
        flex-shrink: 0;
        font-size: 1.8rem;
        font-weight: 700;
        letter-spacing: -0.08em;
    }

    .logo span {
        color: var(--color-brick);
    }

    .logo--active::after {
        position: absolute;
        right: 0;
        bottom: -5px;
        left: 0;
        height: 2px;
        background: var(--color-brick);
        content: '';
    }

    nav ul {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem clamp(0.9rem, 2vw, 2rem);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    nav a {
        position: relative;
        display: inline-block;
        padding-block: 0.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        white-space: nowrap;
    }

    nav a::after {
        position: absolute;
        right: 0;
        bottom: 2px;
        left: 0;
        height: 2px;
        background: var(--color-brick);
        content: '';
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 180ms ease;
    }

    nav a:hover::after,
    nav a.nav-link--active::after {
        transform: scaleX(1);
    }

    nav a.nav-link--active {
        color: var(--color-brick);
    }

    @media (max-width: 650px) {
        .header-inner {
            flex-direction: column;
            gap: 0.5rem;
            padding-block: 1rem;
        }

        nav ul {
            justify-content: center;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        nav a::after {
            transition: none;
        }
    }
</style>
