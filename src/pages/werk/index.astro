---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { internalPath } from '../../utils/paths';

const experience = [
  {
    number: '01',
    period: 'APR 2025 — HEDEN',
    role: 'Customer Success Specialist & Backend developer',
    company: 'GetNoticed B.V.',
    href: 'https://www.getnoticed.nl',
    location: 'Nederweert',
    introduction:
      'Voor Ahold Delhaize combineer ik de rol van technisch aanspreekpunt met backendontwikkeling. Ik begeleid de doorontwikkeling van twaalf recruitmentwebsites en duik zelf de techniek in wanneer dat nodig is.',
    details: [
      'Technisch aanspreekpunt voor Ahold Delhaize binnen GetNoticed, met verantwoordelijkheid voor de technische vragen rondom twaalf recruitmentwebsites.',
      'Begeleiden van de klant bij de verdere ontwikkeling en uitbreiding van de websites: van het bespreken van wensen tot het afstemmen van nieuwe functionaliteiten en projecten.',
      'Onderzoeken en oplossen van technische vraagstukken rondom recruitmentprocessen, ATS-koppelingen en andere integraties.',
      'Zelf backendfunctionaliteiten ontwikkelen, bugs oplossen en technische verbeteringen realiseren binnen het platform.',
      'De schakel vormen tussen Ahold Delhaize, development en het Customer Success-team, zodat afspraken ook technisch goed worden uitgevoerd.',
    ],
    technologies: ['PHP', 'Symfony', 'RabbitMQ', 'MySQL', 'Docker', 'REST API’s'],
  },
  {
    number: '02',
    period: 'FEB 2022 — MRT 2025',
    role: 'Backend developer',
    company: 'Bertels Holland B.V.',
    href: 'http://bertelsholland.com/nl/',
    location: 'Ospel',
    introduction:
      'Hier heb ik mijn basis als backenddeveloper verder uitgebouwd: van applicatieontwikkeling tot integraties en het meedenken over architectuur.',
    details: [
      'Ontwikkeling en onderhoud van webapplicaties met Laravel en PHP.',
      'API-integraties en technische verbeteringen voor onder andere Plagron.',
      'Refactoring van bestaande functionaliteit en bijdragen aan herbruikbare oplossingen.',
      'Meedenken over architectuur, codekwaliteit en het beoordelen van pull requests.',
    ],
    technologies: ['PHP', 'Laravel', 'Statamic', 'JavaScript', 'API-integraties', 'GraphQL'],
  },
  {
    number: '03',
    period: 'EERDERE ERVARING',
    role: 'WordPress developer & IT-stagiair',
    company: 'RIF-IT Services',
    href: 'https://www.rifits.nl',
    location: 'Weert',
    introduction:
      'Een eerdere stap in mijn ontwikkeling, waarin ik praktijkervaring opdeed met het bouwen en onderhouden van websites en kleinere PHP-oplossingen.',
    details: [
      'Ontwikkeling en onderhoud van WordPress-websites.',
      'Werken aan PHP-scripts en kleinere maatwerkoplossingen.',
    ],
    technologies: ['WordPress', 'PHP'],
  },
];

const principles = [
  {
    number: '01',
    title: 'Techniek én mensen.',
    description:
      'Een goede technische oplossing begint met begrijpen wat iemand nodig heeft. Daarom vind ik het leuk om niet alleen te bouwen, maar ook mee te denken.',
  },
  {
    number: '02',
    title: 'Onderhoudbaar is ook een feature.',
    description:
      'Code moet niet alleen vandaag werken. Ik kijk graag verder dan de eerstvolgende release en denk na over de gevolgen van technische keuzes.',
  },
  {
    number: '03',
    title: 'Niet moeilijker dan nodig.',
    description:
      'Ik houd van interessante technische puzzels, maar complexiteit is geen doel op zich. Een eenvoudige oplossing die goed werkt, wint wat mij betreft.',
  },
];
---

<BaseLayout
  title="Werk"
  description="Mijn werkervaring als backenddeveloper en Customer Success Specialist. Van Laravel en API-integraties tot Symfony en recruitmenttechnologie."
>
  <section class="work-hero">
    <div class="container hero-layout">
      <div class="hero-copy">
        <p class="eyebrow">Werk / 02</p>
        <h1>Wat ik doe.<br /><em>En heb gedaan.</em></h1>
        <p class="hero-lead">
          Ik werk het liefst aan de techniek achter applicaties.
          Maar ik vind het minstens zo interessant om te begrijpen
          voor wie ik die techniek eigenlijk bouw.
        </p>
      </div>
      <aside class="hero-aside" aria-label="Mijn werk in het kort">
        <span class="aside-label">In het kort</span>
        <p>Backend in mijn hoofd.<br /><em>De gebruiker in gedachten.</em></p>
        <span class="aside-footer">Het liefst allebei tegelijk.</span>
      </aside>
    </div>
  </section>

  <section class="introduction-section" aria-labelledby="introduction-heading">
    <div class="container introduction-layout">
      <div>
        <p class="eyebrow">01 / Mijn werk</p>
        <h2 id="introduction-heading">Achter de schermen.<br /><em>Met overzicht.</em></h2>
      </div>
      <div class="introduction-copy">
        <p class="lead">
          Ik ben backenddeveloper, maar mijn werk stopt niet zodra de code is geschreven.
        </p>
        <p>
          Ik houd ervan om technische vraagstukken uit te pluizen, integraties te bouwen
          en oplossingen te bedenken die in de praktijk ook echt bruikbaar zijn.
        </p>
        <p>
          In mijn huidige functie combineer ik backendontwikkeling met Customer Success.
          Dat betekent dat ik niet alleen aan de techniek werk, maar ook betrokken ben
          bij de vragen, wensen en uitdagingen erachter.
        </p>
        <p>
          Die combinatie past bij me: inhoudelijk de diepte in wanneer dat nodig is,
          zonder uit het oog te verliezen waarom we iets bouwen.
        </p>
      </div>
    </div>
  </section>

  <section id="ervaring" class="experience-section" aria-labelledby="experience-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">02 / Ervaring</p>
        <h2 id="experience-heading">Waar ik mijn<br /><em>tanden in zet.</em></h2>
        <p>Een overzicht van mijn professionele werk. Geen poespas, beloofd.</p>
      </div>
      <ol class="experience-list">
        {experience.map((job) => (
          <li class="experience-item">
            <div class="experience-meta">
              <span class="experience-number" aria-hidden="true">{job.number} /</span>
              <p class="period">{job.period}</p>
              <p class="location">{job.location}</p>
            </div>
            <div class="experience-content">
              <a class="text-link" href={job.href} target="_blank">
                {job.company} <ArrowIcon size={20} />
              </a>
              <h3>{job.role}</h3>
              <p class="experience-intro">{job.introduction}</p>
              <ul class="responsibilities">
                {job.details.map((detail) => <li>{detail}</li>)}
              </ul>
              <ul class="technology-list" aria-label={`Gebruikte technieken bij ${job.company}`}>
                {job.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="education-section" aria-labelledby="education-heading">
    <div class="container education-layout">
      <div>
        <p class="eyebrow">03 / Opleiding</p>
        <h2 id="education-heading">Blijven leren.<br /><em>Ook buiten school.</em></h2>
      </div>
      <div class="education-content">
        <div class="education-item">
          <p class="education-school">Summa College · Eindhoven</p>
          <p class="education-status">MBO4</p>
          <h3>Software Developer</h3>
          <p>
            Tijdens deze opleiding legde ik de basis voor mijn werk als developer:
            van programmeren tot het ontwikkelen van complete applicaties.
            Die kennis heb ik vervolgens in de praktijk verder uitgebouwd.
          </p>
        </div>
        <div class="education-item">
          <p class="education-school">Avans Hogeschool · 's Hertogenbosch</p>
          <h3>Informatica</h3>
          <p class="education-status">Niet afgerond</p>
          <p>
            Ik heb ook aan Avans gestudeerd, maar deze opleiding niet afgerond.
            Mijn ontwikkeling als developer heb ik daarna vooral voortgezet
            door praktijkervaring op te doen en mezelf te blijven uitdagen.
          </p>
        </div>
        <p class="education-note">
          Een diploma vertelt iets over je opleiding. Wat je daarna blijft leren is naar mijn mening nog belangrijker in dit vak.
        </p>
      </div>
    </div>
  </section>

  <section class="approach-section" aria-labelledby="approach-heading">
    <div class="container">
      <div class="approach-heading">
        <div>
          <p class="eyebrow">04 / Hoe ik werk</p>
          <h2 id="approach-heading">Niet alleen<br /><em>code kloppen.</em></h2>
        </div>
        <p>Een paar uitgangspunten die ik meeneem, ongeacht het project.</p>
      </div>
      <div class="principles-grid">
        {principles.map((principle) => (
          <article class="principle-card">
            <span class="principle-number">{principle.number} /</span>
            <div>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="projects-section" aria-labelledby="projects-heading">
    <div class="container projects-layout">
      <div>
        <p class="eyebrow">05 / De praktijk</p>
        <h2 id="projects-heading">Genoeg verteld.<br /><em>Laat maar zien.</em></h2>
      </div>
      <div class="projects-copy">
        <p class="lead">Een functietitel vertelt natuurlijk maar een deel van het verhaal.</p>
        <p>
          Op mijn projectenpagina laat ik zien waar ik aan heb gewerkt,
          welke technische uitdagingen daarbij kwamen kijken en wat mijn eigen bijdrage was.
        </p>
        <a class="text-link" href={internalPath('projecten/')}>
          Bekijk mijn projecten <ArrowIcon size={20} />
        </a>
      </div>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-heading">
    <div class="container closing-content">
      <p class="eyebrow">06 / Verder praten?</p>
      <h2 id="closing-heading">Misschien bouwen we<br /><em>ooit iets samen.</em></h2>
      <p>Een vraag over mijn ervaring, een interessant idee of gewoon even kennismaken?</p>
      <a class="button" href={internalPath('contact/')}>
        Zeg even hallo <ArrowIcon size={20} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  h1, h2 { letter-spacing: -0.055em; }
  h1 em, h2 em { color: var(--color-brick); font-family: var(--font-accent); font-weight: 500; }
  h2 { font-size: clamp(2.75rem, 6vw, 5rem); line-height: 1.08; }
  .lead { font-size: clamp(1.3rem, 2.5vw, 1.7rem); font-weight: 600; line-height: 1.5; }
  .text-link { display: inline-flex; align-items: center; gap: 0.75rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--color-brick); color: var(--color-brick); font-weight: 700; transition: gap 180ms ease; }
  .text-link:hover { gap: 1.1rem; }
  .work-hero { padding-block: clamp(5rem, 11vw, 10rem); }
  .hero-layout { display: grid; grid-template-columns: minmax(0, 1fr) 290px; align-items: end; gap: clamp(3rem, 8vw, 8rem); }
  h1 { margin-block: 2rem 3rem; font-size: clamp(3.7rem, 9vw, 8rem); line-height: 1.02; }
  .hero-lead { max-width: 720px; margin-bottom: 2.5rem; color: var(--color-muted); font-size: clamp(1.2rem, 2.5vw, 1.65rem); line-height: 1.6; }
  .hero-aside { margin-bottom: 1rem; padding: 2rem; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-sand); transform: rotate(2deg); }
  .aside-label { color: var(--color-brick); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .hero-aside p { margin: 1.5rem 0; font-size: 1.45rem; font-weight: 700; line-height: 1.35; }
  .hero-aside em { color: var(--color-brick); font-family: var(--font-accent); font-weight: 500; }
  .aside-footer { color: var(--color-muted); font-family: var(--font-accent); font-style: italic; }
  .introduction-section { padding-block: clamp(6rem, 11vw, 10rem); background: var(--color-sand); }
  .introduction-layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(3rem, 8vw, 8rem); }
  .introduction-layout h2 { margin-top: 2rem; }
  .introduction-copy { max-width: 610px; }
  .introduction-copy p { margin-bottom: 1.5rem; line-height: 1.8; }
  .introduction-copy p:not(.lead) { color: var(--color-muted); font-size: 1.05rem; }
  .experience-section { padding-block: clamp(6rem, 11vw, 10rem) clamp(3rem, 6vw, 5rem); }
  .section-heading { max-width: 820px; margin-bottom: clamp(3rem, 7vw, 6rem); }
  .section-heading h2 { margin-block: 2rem; }
  .section-heading > p:last-child { max-width: 570px; color: var(--color-muted); font-size: 1.1rem; }
  .experience-list { margin: 0; padding: 0; list-style: none; }
  .experience-item { display: grid; grid-template-columns: minmax(170px, 0.55fr) minmax(0, 1.45fr); gap: clamp(2rem, 7vw, 7rem); padding-block: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--color-border); }
  .experience-item:last-child { border-bottom: 1px solid var(--color-border); }
  .experience-number { display: block; margin-bottom: 2rem; color: var(--color-brick); font-family: var(--font-accent); font-size: 1.6rem; }
  .period { margin-bottom: 0.4rem; font-weight: 700; font-size: 0.9rem; letter-spacing: 0.04em; }
  .location { color: var(--color-muted); font-size: 0.9rem; }
  .company { margin-bottom: 0.6rem; color: var(--color-brick); font-weight: 700; }
  .experience-content h3 { max-width: 760px; margin-bottom: 2rem; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.12; letter-spacing: -0.045em; overflow-wrap: break-word; }
  .experience-intro { max-width: 690px; margin-bottom: 2rem; font-size: 1.15rem; line-height: 1.75; }
  .responsibilities { display: grid; gap: 0.85rem; max-width: 720px; margin: 0 0 2.5rem; padding-left: 1.3rem; color: var(--color-muted); line-height: 1.75; }
  .responsibilities li { padding-left: 0.25rem; }
  .responsibilities li::marker { color: var(--color-brick); }
  .technology-list { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0; padding: 0; list-style: none; }
  .technology-list li { padding: 0.45rem 0.75rem; border: 1px solid var(--color-border); border-radius: 5px; font-size: 0.8rem; font-weight: 600; }
  .education-section { padding-block: clamp(3rem, 6vw, 5rem) clamp(6rem, 11vw, 10rem); }
  .education-layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(3rem, 8vw, 8rem); }
  .education-content { max-width: 610px; }
  .education-school { color: var(--color-brick); font-weight: 700; }
  .education-content h3 { margin-block: 0.75rem 1.25rem; font-size: clamp(2rem, 4vw, 3.25rem); letter-spacing: -0.045em; }
  .education-item { padding-block: 2.5rem; border-top: 1px solid var(--color-border); }
  .education-item p:last-child { max-width: 590px; margin-bottom: 0; line-height: 1.8; }
  .education-status { display: inline-block; margin-bottom: 1.25rem; padding: 0.35rem 0.75rem; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-muted); font-size: 0.8rem; font-weight: 700; }
  .education-item > p:not(.education-school):not(.education-status), .education-note { color: var(--color-muted); line-height: 1.8; }
  .education-note { font-family: var(--font-accent); font-style: italic; }
  .approach-section { padding-block: clamp(6rem, 11vw, 10rem); background: var(--color-sand); }
  .approach-heading { display: flex; justify-content: space-between; align-items: end; gap: 3rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .approach-heading h2 { margin-top: 2rem; }
  .approach-heading > p { max-width: 280px; margin-bottom: 0.5rem; color: var(--color-muted); line-height: 1.8; }
  .principles-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .principle-card { display: flex; flex-direction: column; justify-content: space-between; gap: 3rem; min-height: 340px; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-paper); }
  .principle-number { color: var(--color-brick); font-family: var(--font-accent); }
  .principle-card h3 { margin-bottom: 1rem; font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .principle-card p { margin: 0; color: var(--color-muted); line-height: 1.75; }
  .projects-section { padding-block: clamp(6rem, 11vw, 10rem); }
  .projects-layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(3rem, 8vw, 8rem); }
  .projects-copy { max-width: 610px; }
  .projects-copy p { margin-bottom: 1.5rem; line-height: 1.8; }
  .projects-copy p:not(.lead) { color: var(--color-muted); font-size: 1.05rem; }
  .projects-copy .text-link { margin-top: 1rem; }
  .closing-section { padding-block: clamp(6rem, 11vw, 10rem); background: var(--color-closing-background); color: var(--color-closing-text); }
  .closing-content { max-width: 1050px; }
  .closing-content .eyebrow, .closing-content h2 em { color: var(--color-closing-accent); }
  .closing-content h2 { margin-block: 2rem 3rem; font-size: clamp(3.5rem, 8vw, 7rem); }
  .closing-content > p:not(.eyebrow) { max-width: 630px; margin-bottom: 2rem; font-size: 1.15rem; line-height: 1.8; }
  .closing-content .button { gap: 1rem; }
  @media (max-width: 900px) {
    .hero-layout, .introduction-layout, .education-layout, .projects-layout { grid-template-columns: 1fr; }
    .hero-aside { width: min(100%, 320px); margin: 0 0 0 auto; }
    .principles-grid { grid-template-columns: 1fr; }
    .principle-card { min-height: 220px; }
  }
  @media (max-width: 650px) {
    .experience-item { grid-template-columns: 1fr; gap: 1.5rem; }
    .experience-number { margin-bottom: 1rem; }
    .approach-heading { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .hero-aside { margin-right: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .text-link { transition: none; } }
</style>
