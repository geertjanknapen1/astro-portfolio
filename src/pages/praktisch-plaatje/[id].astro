---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import {
  getCollection,
  render,
  type CollectionEntry,
} from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { internalPath } from '../../utils/paths';
import {
  getPublishedArticles,
  formatArticleDate,
  getReadingTimeInMinutes,
} from '../../utils/articles';

interface Props {
  article: CollectionEntry<'articles'>;
}

export const getStaticPaths = (async () => {
  const articles = getPublishedArticles(
    await getCollection('articles'),
  );

  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { Content } = await render(article);
const readingMinutes = getReadingTimeInMinutes(article.body ?? '');
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  type="article"
>
  <article>
    <header class="article-hero">
      <div class="container">
        <a class="back-link" href={internalPath('praktisch-plaatje/')}>
          <ArrowIcon direction="left" size={18} />
          Alle praktische plaatjes
        </a>

        <p class="eyebrow">{article.data.category}</p>

        <h1>{article.data.title}<span>.</span></h1>

        <p class="article-intro">{article.data.description}</p>

        <div class="article-meta">
          <time datetime={article.data.publishedAt.toISOString()}>
            {formatArticleDate(article.data.publishedAt)}
          </time>

          <span aria-hidden="true">·</span>
          <span>{readingMinutes} min lezen</span>

          {
            article.data.updatedAt && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  Bijgewerkt op {formatArticleDate(article.data.updatedAt)}
                </span>
              </>
            )
          }
        </div>

        {
          article.data.tags.length > 0 && (
            <ul class="tags" aria-label="Onderwerpen">
              {article.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )
        }
      </div>
    </header>

    <section class="article-body-section">
      <div class="container">
        <div class="article-body">
            <Content />
            {
                article.data.disclaimer && (
                    <aside
                        class="article-disclaimer"
                        aria-label="Toelichting bij dit artikel"
                    >
                        <div class="disclaimer-heading">
                            <span aria-hidden="true">ⓘ</span>
                            <strong>Goed om te weten</strong>
                        </div>

                        <p>{article.data.disclaimer}</p>
                        <a href="/astro-portfolio/ai-gebruik-en-werkwijze/">
                          Meer over AI & mijn werkwijze
                        </a>
                    </aside>
                )
            }
        </div>
      </div>
    </section>

    <footer class="article-footer">
      <div class="container">
        <p class="eyebrow">Tot zover mijn gedachten.</p>
        <h2>Meer lezen?</h2>

        <a class="back-link" href={internalPath('praktisch-plaatje/')}>
          <ArrowIcon direction="left" size={18} />
          Terug naar alle praktische plaatjes
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .article-hero {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 9vw, 8rem);
    background: var(--color-sand);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-brick);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .article-hero .back-link {
    margin-bottom: clamp(4rem, 9vw, 7rem);
  }

  h1 {
    max-width: 1000px;
    margin-block: 1.5rem 2rem;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 1.05;
    letter-spacing: -0.06em;
    overflow-wrap: anywhere;
  }

  h1 span {
    color: var(--color-brick);
  }

  .article-intro {
    max-width: 750px;
    color: var(--color-muted);
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
    line-height: 1.65;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.8rem;
  }

  .article-body-section {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .article-body {
    max-width: 760px;
    margin-inline: auto;
    font-size: clamp(1.05rem, 1.6vw, 1.15rem);
    line-height: 1.9;
  }

  .article-body :global(h2) {
    margin-block: 3.5rem 1.25rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .article-body :global(h3) {
    margin-block: 2.5rem 1rem;
    font-size: 1.5rem;
  }

  .article-body :global(p) {
    margin-bottom: 1.75rem;
    color: var(--color-muted);
  }

  .article-body :global(strong) {
    color: var(--color-ink);
  }

  .article-body :global(a) {
    color: var(--color-brick);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 2rem;
    padding-left: 1.5rem;
    color: var(--color-muted);
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body :global(blockquote) {
    margin: 2.5rem 0;
    padding: 0.5rem 0 0.5rem 1.5rem;
    border-left: 3px solid var(--color-brick);
    font-family: var(--font-accent);
    font-size: 1.6rem;
    font-style: italic;
  }

  .article-body :global(pre) {
    overflow-x: auto;
    margin-block: 2rem;
    padding: 1.5rem;
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .article-body :global(:not(pre) > code) {
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    background: var(--color-sand);
    font-size: 0.9em;
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .article-footer {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--color-border);
  }

  .article-footer h2 {
    margin-block: 1rem 2rem;
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.05em;
  }
  .article-disclaimer {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brick);
    border-radius: 8px;
    background: var(--color-sand);
    }

    .disclaimer-heading {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
    color: var(--color-ink);
    font-size: 0.9rem;
    }

    .disclaimer-heading span {
    color: var(--color-brick);
    font-size: 1.2rem;
    }

    .article-disclaimer p,
    .article-disclaimer a {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    }
</style>