---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import {
  getCollection,
  render,
  type CollectionEntry,
} from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { internalPath } from '../../utils/paths';

interface Props {
  project: CollectionEntry<'projects'>;
  previousProject: CollectionEntry<'projects'> | null;
  nextProject: CollectionEntry<'projects'> | null;
}

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects')).sort(
    (a, b) =>
      a.data.order - b.data.order ||
      a.id.localeCompare(b.id)
  );

  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      previousProject: projects[index - 1] ?? null,
      nextProject: projects[index + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const {
  project,
  previousProject,
  nextProject,
} = Astro.props;

const { Content } = await render(project);

const categoryLabel =
  project.data.category === 'personal'
    ? 'Eigen project'
    : 'Professioneel project';

const statusLabel =
  project.data.status === 'in-progress'
    ? 'In ontwikkeling'
    : 'Afgerond';

const projectNumber = String(
  project.data.order
).padStart(2, '0');

const technicalChoices = project.data.technicalChoices;
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  type="article"
>
  <article>
    <header class="project-hero">
      <div class="container">
        <a
          class="back-link"
          href={internalPath('projecten/')}
        >
          <ArrowIcon direction="left" size={18} />
          Alle projecten
        </a>

        <div class="hero-heading">
          <div class="hero-copy">
            <p class="eyebrow">
              {categoryLabel} / {project.data.year}
            </p>

            <h1>
              {project.data.title}<span>.</span>
            </h1>

            <p class="hero-description">
              {project.data.description}
            </p>
          </div>

          <span
            class="project-number"
            aria-hidden="true"
          >
            {projectNumber}
          </span>
        </div>

        <dl class="project-details">
          <div>
            <dt>Project</dt>
            <dd>{categoryLabel}</dd>
          </div>

          <div>
            <dt>Status</dt>
            <dd>{statusLabel}</dd>
          </div>

          {
            project.data.company && (
              <div>
                <dt>Opdrachtgever</dt>
                <dd>{project.data.company}</dd>
              </div>
            )
          }

          {
            project.data.employer && (
              <div>
                <dt>Uitgevoerd vanuit</dt>
                <dd>{project.data.employer}</dd>
              </div>
            )
          }
        </dl>

        {
          project.data.tags.length > 0 && (
            <div class="project-technologies">
              <p class="project-technologies-label">
                Gebruikte technologieën
              </p>

              <ul aria-label="Gebruikte technologieën">
                {
                  project.data.tags.map((tag) => (
                    <li>{tag}</li>
                  ))
                }
              </ul>
            </div>
          )
        }
      </div>
    </header>

    {
      project.data.coverImage && (
        <section
          class="project-visual"
          aria-label={`Afbeelding bij ${project.data.title}`}
        >
          <div class="container">
            <ProjectImage
              src={project.data.coverImage}
              alt={project.data.coverAlt ?? ''}
              caption={project.data.coverCaption}
            />
          </div>
        </section>
      )
    }

    <section
      class="project-story"
      aria-labelledby="story-heading"
    >
      <div class="container story-layout">
        <h2
          class="section-label"
          id="story-heading"
        >
          <span>01 /</span>
          Het verhaal
        </h2>

        <div class="story-content">
          <Content />
        </div>
      </div>
    </section>

    {
      technicalChoices.length > 0 && (
        <section
          class="project-tech"
          aria-labelledby="tech-heading"
        >
          <div class="container story-layout">
            <h2
              class="section-label"
              id="tech-heading"
            >
              <span>02 /</span>
              De techniek
            </h2>

            <div class="tech-content">
              <h3 class="tech-title">
                De keuzes achter de code<span>.</span>
              </h3>

              {
                project.data.technicalIntro && (
                  <p class="tech-intro">
                    {project.data.technicalIntro}
                  </p>
                )
              }

              <div class="choice-list">
                {
                  technicalChoices.map((choice, index) => (
                    <div class="choice">
                      <div class="choice-heading">
                        <span
                          class="choice-index"
                          aria-hidden="true"
                        >
                          {String(index + 1).padStart(2, '0')}
                        </span>

                        <h4>{choice.title}</h4>
                      </div>

                      <p>{choice.description}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </section>
      )
    }

    <footer class="project-footer">
      <div class="container">
        {
          (previousProject || nextProject) && (
            <div class="project-navigation">
              <p class="eyebrow">
                Ontdek meer projecten
              </p>

              <nav
                class="navigation-grid"
                aria-label="Navigatie tussen projecten"
              >
                {
                  previousProject && (
                    <a
                      class="navigation-card previous"
                      href={internalPath(
                        `projecten/${previousProject.id}/`
                      )}
                      rel="prev"
                    >
                      <span class="navigation-label">
                        <ArrowIcon
                          direction="left"
                          size={16}
                        />
                        Vorig project
                      </span>

                      <span class="navigation-title">
                        <span class="navigation-number">
                          {String(
                            previousProject.data.order
                          ).padStart(2, '0')}
                        </span>

                        {previousProject.data.title}
                      </span>
                    </a>
                  )
                }

                {
                  nextProject && (
                    <a
                      class="navigation-card next"
                      href={internalPath(
                        `projecten/${nextProject.id}/`
                      )}
                      rel="next"
                    >
                      <span class="navigation-label">
                        Volgend project
                        <ArrowIcon
                          direction="right"
                          size={16}
                        />
                      </span>

                      <span class="navigation-title">
                        <span class="navigation-number">
                          {String(
                            nextProject.data.order
                          ).padStart(2, '0')}
                        </span>

                        {nextProject.data.title}
                      </span>
                    </a>
                  )
                }
              </nav>
            </div>
          )
        }

        <a
          class="all-projects"
          href={internalPath('projecten/')}
        >
          Alle projecten bekijken
          <ArrowIcon size={18} />
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  /* Hero */

  .project-hero {
    padding-block:
      clamp(2rem, 5vw, 4rem)
      clamp(4rem, 9vw, 8rem);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(4rem, 9vw, 8rem);
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .back-link:hover {
    color: var(--color-brick);
  }

  .hero-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .hero-copy {
    max-width: 850px;
    min-width: 0;
  }

  h1 {
    margin-block: 1.5rem 2rem;
    font-size: clamp(4rem, 11vw, 9rem);
    line-height: 1;
    letter-spacing: -0.065em;
    overflow-wrap: anywhere;
  }

  h1 span,
  .tech-title span {
    color: var(--color-brick);
  }

  .hero-description {
    max-width: 740px;
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(1.25rem, 2.5vw, 1.8rem);
    line-height: 1.55;
  }

  .project-number {
    flex-shrink: 0;
    color: var(--color-border);
    font-family: var(--font-accent);
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 1;
  }

  /* Projectinformatie */

  .project-details {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 4rem;
    margin: clamp(4rem, 8vw, 7rem) 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .project-details > div {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-details dt,
  .project-technologies-label {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-details dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  /* Technologieën in de hero */

  .project-technologies {
    margin-top: 2.5rem;
  }

  .project-technologies-label {
    margin-bottom: 1rem;
  }

  .project-technologies ul {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-technologies li {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    width: fit-content;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Projectafbeelding */

  .project-visual {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .project-visual .container {
    max-width: 1120px;
  }

  /* Genummerde secties */

  .project-story,
  .project-tech {
    padding-block: clamp(4rem, 9vw, 9rem);
    border-top: 1px solid var(--color-border);
  }

  .project-tech {
    background: var(--color-sand);
  }

  .story-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
  }

  .section-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 0;
    padding-top: 0.4rem;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: normal;
  }

  .section-label span {
    color: var(--color-brick);
    white-space: nowrap;
  }

  /* Projectverhaal */

  .story-content {
    width: 100%;
    max-width: 760px;
    min-width: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.15rem);
    line-height: 1.9;
  }

  .story-content :global(h2) {
    margin-block: 4rem 1.5rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.2;
  }

  .story-content :global(h2:first-child) {
    margin-top: 0;
  }

  .story-content :global(h3) {
    margin-block: 2.5rem 1rem;
    font-size: 1.5rem;
  }

  .story-content :global(p) {
    margin-bottom: 1.75rem;
    color: var(--color-muted);
  }

  .story-content :global(strong) {
    color: var(--color-ink);
  }

  .story-content :global(a) {
    color: var(--color-brick);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .story-content :global(blockquote) {
    margin: 3rem 0;
    padding: 0.5rem 0 0.5rem 2rem;
    border-left: 3px solid var(--color-brick);
    font-family: var(--font-accent);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-style: italic;
    line-height: 1.5;
  }

  .story-content :global(blockquote p) {
    margin: 0;
    color: var(--color-ink);
  }

  .story-content :global(ul),
  .story-content :global(ol) {
    margin-bottom: 2rem;
    padding-left: 1.5rem;
    color: var(--color-muted);
  }

  .story-content :global(li) {
    margin-bottom: 0.5rem;
  }

  /* Technische keuzes */

  .tech-content {
    max-width: 760px;
    min-width: 0;
  }

  .tech-title {
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.2;
  }

  .tech-intro {
    max-width: 680px;
    margin-bottom: 2.5rem;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 1.6vw, 1.15rem);
    line-height: 1.85;
  }

  .choice-list {
    border-top: 1px solid var(--color-border);
  }

  .choice {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .choice-heading {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .choice-index {
    flex-shrink: 0;
    color: var(--color-brick);
    font-family: var(--font-accent);
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .choice h4 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.3;
  }

  .choice p {
    margin: 0;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  /* Footer */

  .project-footer {
    padding-block: clamp(3rem, 6vw, 6rem);
    border-top: 1px solid var(--color-border);
  }

  /* Vorig en volgend project */

  .project-navigation {
    padding-top: 1rem;
  }

  .navigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .navigation-grid > .navigation-card:only-child {
    grid-column: 1 / -1;
  }

  .navigation-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 180px;
    gap: 3rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition:
      background 180ms ease,
      border-color 180ms ease;
  }

  .navigation-card:hover {
    border-color: var(--color-brick);
    background: var(--color-sand);
    color: var(--color-ink);
  }

  .navigation-card.next {
    text-align: right;
  }

  .navigation-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-brick);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .navigation-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .next .navigation-title {
    justify-content: flex-end;
  }

  .navigation-number {
    color: var(--color-brick);
    font-family: var(--font-accent);
    font-size: 0.7em;
    font-weight: 500;
  }

  /* Terug naar overzicht */

  .all-projects {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: fit-content;
    margin: 3rem auto 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .all-projects:hover {
    border-color: var(--color-brick);
    color: var(--color-brick);
  }

  /* Responsive */

  @media (max-width: 760px) {
    .project-number {
      display: none;
    }

    .story-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .project-details {
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .navigation-grid {
      grid-template-columns: 1fr;
    }

    .navigation-card {
      min-height: 140px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation-card {
      transition: none;
    }
  }
</style>
