
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);

const base = import.meta.env.BASE_URL;

const categoryLabel =
  project.data.category === 'personal'
    ? 'Eigen project'
    : 'Professioneel project';

const statusLabel =
  project.data.status === 'in-progress'
    ? 'In ontwikkeling'
    : 'Afgerond';
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
>
  <article>
    <header class="project-hero">
      <div class="container">
        <a class="back-link" href={`${base}projecten/`}>
          ← Alle projecten
        </a>

        <p class="eyebrow">
          {categoryLabel} · {statusLabel}
        </p>

        <h1>{project.data.title}<span>.</span></h1>

        <p class="description">
          {project.data.description}
        </p>

        {
            (project.data.company || project.data.employer) && (
                <dl class="project-meta">
                {project.data.company && (
                    <div>
                    <dt>Opdrachtgever</dt>
                    <dd>{project.data.company}</dd>
                    </div>
                )}

                {project.data.employer && (
                    <div>
                    <dt>Uitgevoerd vanuit</dt>
                    <dd>{project.data.employer}</dd>
                    </div>
                )}
                </dl>
            )
        }

        <ul class="tags" aria-label="Gebruikte technieken">
          {project.data.tags.map((tag: string) => (
            <li>{tag}</li>
          ))}
        </ul>
      </div>
    </header>

    <div class="container">
      <div class="project-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-hero {
    padding-block: clamp(4rem, 9vw, 8rem);
    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 4rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 600;
  }

  h1 {
    margin-block: 1rem 2rem;
    font-size: clamp(4rem, 10vw, 8rem);
  }

  h1 span {
    color: var(--color-brick);
  }

  .description {
    max-width: 720px;
    color: var(--color-muted);
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 4rem;
    margin-block: 2rem;
   }

   .project-meta dt {
    margin-bottom: 0.35rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

   .project-meta dd {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .project-body {
    max-width: 760px;
    margin-inline: auto;
    padding-block: clamp(4rem, 8vw, 7rem);
    font-size: 1.1rem;
    line-height: 1.85;
  }

  /* Styling voor HTML die uit Markdown wordt gegenereerd. */
  .project-body :global(h2) {
    margin-block: 3rem 1rem;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
  }

  .project-body :global(h2:first-child) {
    margin-top: 0;
  }

  .project-body :global(p) {
    margin-bottom: 1.5rem;
  }

  .project-body :global(a) {
    color: var(--color-brick);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-body :global(img) {
    margin-block: 2.5rem;
    border-radius: 8px;
  }
</style>
