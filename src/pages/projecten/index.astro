
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projecten"
  description="Een kijkje achter de schermen bij de projecten van Geert-Jan Knapen."
>
  <section class="projects-page">
    <div class="container">
      <header class="page-heading">
        <p class="eyebrow">Achter de schermen</p>

        <h1>Dingen waar ik aan heb gebouwd.</h1>

        <p>
          Een verzameling projecten, technische uitdagingen
          en dingen die ik onderweg heb geleerd.
        </p>
      </header>

      <div class="project-list">
        {projects.map((project, index) => (
          <ProjectCard
            number={String(index + 1).padStart(2, '0')}
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            href={`${base}projecten/${project.id}/`}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page {
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .page-heading {
    max-width: 800px;
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }

  h1 {
    margin-block: 1.5rem;
    font-size: clamp(3rem, 7vw, 6rem);
  }

  .page-heading > p:last-child {
    max-width: 600px;
    color: var(--color-muted);
    font-size: 1.2rem;
  }

  .project-list {
    border-bottom: 1px solid var(--color-border);
  }
</style>
