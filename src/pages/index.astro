---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import ProjectCard from '../components/ProjectCard.astro';

import { getCollection } from 'astro:content';
import { internalPath } from '../utils/paths';

const projects = (
  await getCollection('projects', ({ data }) => data.featured)
).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    a.id.localeCompare(b.id),
);
---

<BaseLayout
  title="Home"
  description="Geert-Jan Knapen: backenddeveloper met een voorliefde voor PHP, Symfony/Laravel en software die gewoon goed werkt."
>
  <!-- HERO -->

  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <p class="eyebrow">
          Hallo, ik ben Geert-Jan 👋
        </p>

        <h1>
          Ik bouw graag dingen die
          <span>gewoon goed werken.</span>
        </h1>

        <p class="intro">
          Backenddeveloper met een voorliefde
          voor PHP, Symfony/Laravel en oplossingen
          waar mensen écht iets aan hebben.
        </p>

        <div class="hero-actions">
          <a
            class="button"
            href={internalPath('over-mij/')}
          >
            Even kennismaken?

            <ArrowIcon size={20} />
          </a>

          <a
            class="button button--outline"
            href="#achter-de-schermen"
          >
            Achter de schermen
          </a>
        </div>
      </div>

      <div class="hero-note">
        <span class="note-label">
          Definiërend
        </span>

        <p>
          Niet lullen, maar poetsen.

          <em>
            Toch eerst even nadenken.
          </em>
        </p>
      </div>
    </div>
  </section>

  <!-- OVER MIJ -->

  <section
    id="over-mij"
    class="about-section"
  >
    <div class="container about-inner">
      <div class="about-heading">
        <p class="eyebrow">
          Even voorstellen
        </p>

        <h2>
          Meer dan enkel
          <em>code kloppen.</em>
        </h2>

        <span
          class="about-decoration"
          aria-hidden="true"
        >
          *
        </span>
      </div>

      <div class="about-copy">
        <p class="about-lead">
          Backenddeveloper, Limburger
          en iemand die ook
          in zijn vrije tijd graag
          achter een computer zit.
        </p>

        <p>
          Ik ben Geert-Jan Knapen.
          Ik houd van technische uitdagingen,
          nette code en software waar
          mensen daadwerkelijk iets
          aan hebben.
        </p>

        <p>
          Mijn leven bestaat gelukkig wel uit meer dan variabelen, foutmeldingen en if-statements.
        </p>

        <a
          class="about-link"
          href={internalPath('over-mij/')}
        >
          Meer over mij

          <ArrowIcon size={20} />
        </a>
      </div>
    </div>
  </section>

  <!-- PROJECTEN -->

  <section
    id="achter-de-schermen"
    class="projects-section"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            Achter de schermen
          </p>

          <h2>
            Dingen waar ik
            aan gebouwd heb.
          </h2>
        </div>

        <p>
          Projecten waar ik met plezier mijn tanden in heb gezet.
        </p>
      </div>

      <div class="project-list">
        {
          projects.map((project, index) => (
            <ProjectCard
              number={String(index + 1).padStart(2, '0')}
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              coverImage={project.data.coverImage}
              href={internalPath(`projecten/${project.id}/`)}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */

  .hero {
    padding-block: clamp(5rem, 12vw, 10rem);
  }

  .hero-inner {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      260px;
    align-items: end;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .hero-content {
    max-width: 790px;
  }

  h1 {
    max-width: 800px;
    margin-block: 1.5rem;
    font-size: clamp(3.0rem, 6.0vw, 6.0rem);
    font-weight: 700;
    line-height: 1.05;
  }

  h1 span {
    margin-left: 0.15em;
    color: var(--color-brick);
  }

  .intro {
    max-width: 600px;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero-actions a {
    gap: 0.75rem;
  }

  .hero-note {
    position: relative;
    margin-bottom: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-sand);
    transform: rotate(3deg);
  }

  .note-label {
    color: var(--color-brick);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-note p {
    margin: 0.75rem 0 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .hero-note em {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-accent);
    font-weight: 500;
  }

  /* OVER MIJ */

  .about-section {
    padding-block: clamp(5rem, 9vw, 8rem);
    background: var(--color-sand);
  }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 8vw, 7rem);
  }

  .about-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
  }

  .about-heading h2 {
    margin-block: 1.5rem;
  }

  .about-heading h2 em {
    display: block;
    color: var(--color-brick);
    font-family: var(--font-accent);
    font-weight: 500;
  }

  .about-decoration {
    margin-top: auto;
    color: var(--color-brick);
    font-family: var(--font-accent);
    font-size: clamp(5rem, 12vw, 9rem);
    line-height: 0.8;
  }

  .about-copy {
    max-width: 550px;
    font-size: 1.05rem;
  }

  .about-copy p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  .about-lead {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 700;
    line-height: 1.5 !important;
  }

  .about-copy p:not(.about-lead) {
    color: var(--color-muted);
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-brick);
    color: var(--color-brick);
    font-weight: 700;
    transition: gap 180ms ease;
  }

  .about-link:hover {
    gap: 1.1rem;
  }

  /* PROJECTEN */

  .projects-section {
    padding-block: clamp(6rem, 12vw, 10rem);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .section-heading h2 {
    max-width: 650px;
    margin-bottom: 0;
  }

  .section-heading > p {
    max-width: 300px;
    margin-bottom: 0.5rem;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .project-list {
    display: flex;
    flex-direction: column;
  }

  /* RESPONSIVE */

  @media (max-width: 800px) {
    .hero-inner,
    .about-inner {
      grid-template-columns: 1fr;
    }

    .hero-note {
      max-width: 320px;
      margin: 2rem 0 0;
      transform: rotate(-2deg);
    }

    .about-decoration {
      display: none;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-link {
      transition: none;
    }
  }
</style>
