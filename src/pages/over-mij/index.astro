---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { internalPath } from '../../utils/paths';

const portrait = internalPath('images/over-mij/over-mij-headshot.JPEG');
const portraitAlt = 'Huisgemaakte portretfoto van Geert-Jan Knapen';

const facts = [
  {
    number: '01',
    title: 'Backender in hart en nieren',
    description:
      'Geef mij een interessante technische puzzel en ik ben voorlopig wel even zoet. Het liefst eentje waar uiteindelijk ook iemand iets aan heeft.',
  },
  {
    number: '02',
    title: 'Denken, dan pas bouwen.',
    description:
      'Nette, onderhoudbare code is belangrijk. Niet omdat alles perfect moet zijn, maar omdat het over een halfjaar ook nog begrepen moet worden.',
  },
  {
    number: '03',
    title: 'Normaal is gek genoeg.',
    description:
      'Ik neem mijn werk serieus, mezelf wat minder. Je kunt prima professioneel zijn zonder de hele dag ingewikkeld te doen.',
  },
];

const fitPoints = [
  {
    number: '01',
    title: 'Iets om mijn tanden in te zetten',
    description:
      'Ik vind het fijn om verantwoordelijkheid te krijgen over software van begin tot eind, niet alleen een los ticket om af te werken.',
  },
  {
    number: '02',
    title: 'Mee kunnen denken',
    description:
      'Niet alleen vertellen wat er gebouwd moet worden, maar samen nadenken over waarom en hoe we dat het beste aanpakken.',
  },
  {
    number: '03',
    title: 'Kwaliteit zonder gedoe',
    description:
      'Goede software hoeft niet ingewikkeld te zijn. Ik werk graag met mensen die kwaliteit belangrijk vinden, maar wel pragmatisch blijven.',
  },
];

const interests = [
  {
    number: '01',
    title: 'Festivals, concerten en muziek',
    description:
      'Even geen scherm, geen code en geen foutmeldingen. Gewoon goede muziek en een gezellige avond.',
  },
  {
    number: '02',
    title: 'Sjaele zeiver',
    description:
      'Sarcasme, droge humor en een flinkje portie sjaele zeiver. Maar een goed gesprek met wat inhoud? Daar ben ik net zo goed voor te porren.',
  },
  {
    number: '03',
    title: 'Vastelaovundj',
    description:
      'Als rasechte Limburger mag dit natuurlijk niet ontbreken. Een paar dagen waarop mijn planning heel erg flexibel (en soms wat wazig) wordt.',
  },
  {
    number: '04',
    title: 'Toch weer programmeren',
    description:
      'Ja, zelfs buiten werktijd. Gewoon, omdat dat leuk is, ik ben verder geen nerd of zo. Ik blijf mezelf op professioneel vlak graag uitdagen.',
  },
];

const technologies = [
  'PHP',
  'Symfony',
  'Laravel',
  'PostgreSQL',
  'MySQL',
  'Docker',
  'Git',
  'REST API’s',
];
---

<BaseLayout
  title="Over mij"
  description="Leer Geert-Jan Knapen kennen. Backenddeveloper, liefhebber van goed doordachte software en iemand die zichzelf vooral niet te serieus neemt."
>
  <!-- INTRODUCTIE MET FOTO -->
  <section class="about-hero">
    <div class="container">
      <p class="eyebrow">Over mij / 01</p>

      <div class="hero-layout">
        <div class="hero-content">
          <h1>
            Achter<br />
            <em>de code.</em>
          </h1>

          <p class="hero-intro">
            Hoi, ik ben Geert-Jan.
            Backenddeveloper, Limburger en
            iemand die zichzelf graag wijsmaakt
            dat hij na werktijd niet meer
            achter een apparaat gaat zitten.
          </p>

          <p class="hero-description">
            Spoiler: dat laatste lukt niet altijd.
          </p>

          <a class="text-link" href="#even-voorstellen">
            Aangenaam, trouwens.
            <ArrowIcon size={20} />
          </a>
        </div>

        <div class="hero-visual">
          <figure class="portrait-frame">
            <figcaption class="portrait-caption">
              {portraitAlt}
            </figcaption>

            <img
              src={portrait}
              alt={portraitAlt}
              width="1000"
              height="1300"
              loading="eager"
              fetchpriority="high"
            />
          </figure>

          <aside class="hero-note" aria-label="Persoonlijke opmerking">
            <span class="note-label">Sidenote</span>
            <p>Neem vooral niet alles wat ik zeg serieus.</p>
            <span class="note-footer">sjaele zeiver is een hobby van me.</span>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- EVEN VOORSTELLEN -->
  <section id="even-voorstellen" class="introduction-section">
    <div class="container introduction-layout">
      <div class="section-heading">
        <p class="eyebrow">01 / Even voorstellen</p>

        <h2>
          Meer dan enkel<br />
          <em>een developer.</em>
        </h2>
      </div>

      <div class="introduction-copy">
        <p class="lead">Ik begrijp graag hoe dingen werken.</p>

        <p>
          Maar ook waarom dingen af en toe niet werken. Dat verklaart denk ik
          voor een deel ook waarom ik in de softwareontwikkeling ben gerold.
        </p>

        <p>
          Al een tijdje werk ik voornamelijk aan de backend van applicaties.
          Bedrijfslogica, integraties en technische uitdagingen die voor de
          gebruikers vaak onzichtbaar blijven, daar voel ik me thuis.
        </p>

        <p>
          Het tofste is software ontwikkelen waar mensen echt iets aan hebben.
          Dat kan tegenwoordig iedereen, daarom wil ik software ook graag
          onderhoudbaar en toekomstbestendig maken. Dat hoeft niet ingewikkeld
          te zijn, <abbr title="Keep It Simple, Stupid">KISS</abbr>.
        </p>

        <p>
          Dat betekent natuurlijk niet dat ik het standaard Hollywood
          developer-stereotype representeer, integendeel zelfs. Al ben ik wel
          van nature wat meer introvert.
        </p>
      </div>
    </div>
  </section>

  <!-- HOE IK WERK -->
  <section class="approach-section">
    <div class="container">
      <div class="approach-heading">
        <div>
          <p class="eyebrow">02 / De aard van het beestje</p>

          <h2>
            Mijn werkwijze,<br />
            <em>mijn aard.</em>
          </h2>
        </div>

        <p>
          Een aantal dingen die je vrij snel ontdekt als we samenwerken.
        </p>
      </div>

      <div class="facts-grid">
        {facts.map((fact) => (
          <article class="fact-card">
            <span class="fact-number">{fact.number} /</span>

            <div>
              <h3>{fact.title}</h3>
              <p>{fact.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WERK EN TECHNIEK -->
  <section class="work-section">
    <div class="container work-layout">
      <div class="section-heading">
        <p class="eyebrow">03 / Achter de schermen</p>

        <h2>
          Dingen die<br />
          <em>gewoon werken.</em>
        </h2>

        <p class="heading-description">
          Daar word ik dus enthousiast van!
        </p>
      </div>

      <div class="work-content">
        <p class="lead">
          Van mijn favoriete werk ziet de gebruiker niks.
        </p>

        <p>
          API-integraties, architectuur of andere mooie
          backendfunctionaliteiten. Daar werk ik het liefst aan.
        </p>

        <p>
          Ik vind het wel belangrijk om verder te kijken.
          De functionaliteiten die je vandaag implementeert moeten volgende
          week ook nog onderhoudbaar zijn.
        </p>

        <p>
          Naast zelf ontwikkelen zet ik mijn brein ook graag aan het werk.
          Meedenken over technische keuzes, architectuur en codekwaliteit doe
          ik ook graag. Een goede oplossing is in mijn optiek nooit degene met
          de meeste of complexste code.
        </p>

        <div class="technology-block">
          <h3>Mijn digitaal gereedschap.</h3>

          <ul class="technology-list">
            {technologies.map((technology) => (
              <li>{technology}</li>
            ))}
          </ul>

          <p class="technology-note">
            Niet om indruk te maken, gewoon technologieën waarmee ik graag werk.
          </p>
        </div>

        <a class="text-link" href={internalPath('projecten/')}>
          Bekijk waar ik aan heb gebouwd
          <ArrowIcon size={20} />
        </a>
      </div>
    </div>
  </section>

  <!-- OP MIJN PLEK -->
  <section class="fit-section">
    <div class="container">
      <div class="fit-heading">
        <div>
          <p class="eyebrow">04 / Op mijn plek</p>

          <h2>
            Geef me iets om<br />
            <em>mijn tanden in te zetten.</em>
          </h2>
        </div>

        <p>
          Eigenaarschap over mijn werk is belangrijk voor me.
        </p>
      </div>

      <div class="fit-introduction">
        <p class="lead">
          Het liefst werk ik aan software die ik niet na drie weken
          alweer gedag hoef te zeggen.
        </p>

        <div class="fit-copy">
          <p>
            Ik kom het beste tot mijn recht in een omgeving waar developers niet alleen uitvoeren, maar ook mogen meedenken over de oplossing.
            Begrijpen waarom we iets bouwen, keuzes kunnen bespreken en daarna zorgen dat het technisch goed in elkaar zit.
            
          </p>

          <p>
            Daarbij werk ik graag samen met mensen die kwaliteit belangrijk vinden zonder van iedere beslissing een meer-weken proces te maken.
            Goed nadenken, netjes bouwen, kritische feedback geven en samen zorgen dat het functioneert.
          </p>
        </div>
      </div>

      <div class="fit-grid">
        {fitPoints.map((point) => (
          <article class="fit-card">
            <span class="fit-number">{point.number} /</span>

            <div>
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="cv-row">
        <div>
          <p class="cv-kicker">Liever iets minder tekst?</p>

          <p class="cv-description">
            Werkervaring, opleiding en technische kennis staan ook netjes in een ouderwets CV. 
          </p>
        </div>

        <a
          class="text-link"
          href={internalPath('cv/CV_Geert-Jan_Knapen_PDF.pdf')}
          download
        >
          Download mijn cv
          <ArrowIcon direction="down" size={20} />
        </a>
      </div>
    </div>
  </section>

  <!-- BUITEN WERKTIJD -->
  <section class="personal-section">
    <div class="container">
      <div class="personal-heading">
        <p class="eyebrow">05 / Laptop dicht</p>

        <h2>
          Er bestaat ook nog<br />
          <em>een buitenwereld.</em>
        </h2>

        <p>Zeggen ze dan hè.</p>
      </div>

      <div class="personal-introduction">
        <p>
          Hoe interessant en tof ik programmeren ook vind, er zijn ook een
          aantal andere dingen waaraan ik mijn tijd spendeer. Een goed
          (kleinschalig) festival of concert, Vastelaovundj of een gezellige
          avond met de vriendengroep? Daar maak je me net zo blij mee.
        </p>

        <p>
          Verder houd ik van sarcasme, droge humor, 80s & 90s muziek en een
          flinke portie sjaele zeiver. Naast dat ik heel lang over onzin kan
          praten kan ik net zo goed genieten van een gesprek met een tikkeltje
          meer inhoud. Technologie, geschiedenis of echt filosofische vragen
          zoals waar we vandaan komen, daar houd je me ook zoet mee.
        </p>
      </div>

      <div class="interests-grid">
        {interests.map((interest) => (
          <article class="interest-card">
            <span class="interest-number">{interest.number} /</span>

            <div class="interest-content">
              <h3>{interest.title}</h3>
              <p>{interest.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PACT -->
  <section class="hobby-section">
    <div class="container hobby-layout">
      <div class="hobby-label">
        <p class="eyebrow">06 / Blijkbaar toch weer code</p>
        <span class="hobby-decoration" aria-hidden="true">*</span>
      </div>

      <div class="hobby-content">
        <h2>
          Vrije tijd?<br />
          <em>Toch een projectje.</em>
        </h2>

        <p>
          Naast het werk programmeer ik ook nog, niet omdat ik een coole
          side-hustle wil of denk de volgende technologische doorbraak te maken.
          Gewoon, omdat het kan.
        </p>

        <p>
          Een van die hobbyprojecten is <strong>Pact</strong>. Een project
          waarmee ik experimenteer met architectuur, Symfony en het ontwikkelen
          van een SaaS-applicatie.
        </p>

        <p>
          Op die manier blijf ik nieuwe dingen proberen en mezelf technisch
          ontwikkelen. Verder is het natuurlijk ook gewoon heel erg leuk.
        </p>

        <a class="text-link" href={internalPath('projecten/pact/')}>
          Meer over Pact
          <ArrowIcon size={20} />
        </a>
      </div>
    </div>
  </section>

  <!-- AFSLUITING -->
  <section class="about-closing">
    <div class="container closing-layout">
      <p class="eyebrow">07 / Enne?</p>

      <h2>
        Nu ben ik<br />
        <em>benieuwd naar jou.</em>
      </h2>

      <p>
        Vraag over mijn werk of zin om kennis te maken?
      </p>

      <p>
        Stuur gerust een berichtje. Ik beloof dat ik
        niet uitsluitend over programmeren praat.
      </p>

      <a class="button" href={internalPath('contact/')}>
        Zeg even hallo
        <ArrowIcon size={20} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  h1,
  h2 {
    letter-spacing: -0.055em;
  }

  h2 {
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 1.08;
  }

  h1 em,
  h2 em {
    color: var(--color-brick);
    font-family: var(--font-accent);
    font-weight: 500;
  }

  .lead {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 600;
    line-height: 1.5;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-brick);
    color: var(--color-brick);
    font-weight: 700;
    transition: gap 180ms ease;
  }

  .text-link:hover {
    gap: 1.1rem;
  }

  /* Hero */

  .about-hero {
    padding-block:
      clamp(5rem, 11vw, 10rem)
      clamp(6rem, 12vw, 11rem);
  }

  .hero-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(260px, 390px);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    margin-top: 2rem;
  }

  .hero-content {
    min-width: 0;
  }

  h1 {
    margin-bottom: clamp(2rem, 5vw, 4rem);
    font-size: clamp(4rem, 11vw, 9rem);
    line-height: 0.98;
  }

  .hero-intro {
    max-width: 650px;
    margin-bottom: 1.5rem;
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    font-weight: 600;
    line-height: 1.55;
  }

  .hero-description {
    margin-bottom: 2.5rem;
    color: var(--color-muted);
    font-family: var(--font-accent);
    font-size: 1.3rem;
    font-style: italic;
  }

  .hero-visual {
    position: relative;
    min-width: 0;
    padding-bottom: 5rem;
  }

  .portrait-frame {
    position: relative;
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-sand);
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 35%;
  }

  .portrait-caption {
    padding: 0.65rem 1rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .hero-note {
    position: absolute;
    right: -0.75rem;
    bottom: 0;
    width: min(90%, 290px);
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-sand);
    box-shadow: 0 12px 30px var(--color-menu-shadow);
    transform: rotate(3deg);
  }

  .note-label {
    color: var(--color-brick);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-note p {
    margin-block: 1rem;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .note-footer {
    color: var(--color-muted);
    font-family: var(--font-accent);
    font-size: 1.05rem;
    font-style: italic;
  }

  /* Introductie */

  .introduction-section {
    padding-block: clamp(6rem, 11vw, 10rem);
    background: var(--color-sand);
  }

  .introduction-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .section-heading h2 {
    margin-top: 2rem;
  }

  .introduction-copy {
    max-width: 600px;
  }

  .introduction-copy p,
  .work-content > p {
    margin-bottom: 1.5rem;
    line-height: 1.85;
  }

  .introduction-copy p:not(.lead),
  .work-content > p:not(.lead) {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  /* Werkwijze */

  .approach-section {
    padding-block: clamp(6rem, 11vw, 10rem);
  }

  .approach-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .approach-heading h2 {
    margin-block: 2rem 0;
  }

  .approach-heading > p {
    max-width: 300px;
    margin-bottom: 0.5rem;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .fact-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4rem;
    min-height: 350px;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .fact-number,
  .interest-number,
  .fit-number {
    color: var(--color-brick);
    font-family: var(--font-accent);
  }

  .fact-card h3 {
    margin-bottom: 1.25rem;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }

  .fact-card p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.8;
  }

  /* Werk */

  .work-section {
    padding-block: clamp(6rem, 11vw, 10rem);
    border-top: 1px solid var(--color-border);
  }

  .work-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .heading-description {
    margin-top: 2rem;
    color: var(--color-muted);
    font-family: var(--font-accent);
    font-size: 1.25rem;
    font-style: italic;
  }

  .work-content {
    max-width: 620px;
  }

  .technology-block {
    margin-block: 3rem;
    padding-block: 2rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .technology-block h3 {
    max-width: 400px;
    margin-bottom: 1.5rem;
    font-size: 1.3rem;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .technology-list li {
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .technology-note {
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-family: var(--font-accent);
    font-style: italic;
  }

  /* Op mijn plek */

  .fit-section {
    padding-block: clamp(6rem, 11vw, 10rem);
    background: var(--color-sand);
  }

  .fit-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .fit-heading h2 {
    margin-block: 2rem 0;
  }

  .fit-heading > p {
    max-width: 320px;
    margin-bottom: 0.5rem;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .fit-introduction {
    display: grid;
    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);
    gap: clamp(2rem, 7vw, 7rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .fit-introduction .lead {
    max-width: 470px;
    margin: 0;
  }

  .fit-copy {
    max-width: 600px;
  }

  .fit-copy p {
    margin-block: 0 1.5rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .fit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .fit-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: 280px;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-paper);
  }

  .fit-card h3 {
    margin-bottom: 1rem;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
  }

  .fit-card p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .cv-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-block: 2rem 0.5rem;
    border-top: 1px solid var(--color-border);
  }

  .cv-kicker {
