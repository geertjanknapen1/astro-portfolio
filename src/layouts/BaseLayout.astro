---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { internalPath } from '../utils/paths';

import '../styles/general.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = 'Het portfolio van Geert-Jan Knapen. Backenddeveloper met een voorliefde voor PHP, Symfony en software die gewoon goed werkt.',
  type = 'website',
  noindex = false,
} = Astro.props;

const siteName = 'Geert-Jan Knapen';

const pageTitle =
  title === 'Home'
    ? `${siteName} | Backenddeveloper`
    : `${title} | ${siteName}`;

// Astro.url bevat de actuele pagina-URL.
// Eventuele queryparameters en fragmenten
// horen niet thuis in een canonical URL.

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin);

const canonical = canonicalUrl.toString();

const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content="#f7f4ee"
    />

    <!-- Algemene SEO -->

    <title>{pageTitle}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content={robotsContent}
    />

    <link
      rel="canonical"
      href={canonical}
    />

    <!-- Open Graph -->

    <meta
      property="og:type"
      content={type}
    />

    <meta
      property="og:locale"
      content="nl_NL"
    />

    <meta
      property="og:site_name"
      content={siteName}
    />

    <meta
      property="og:title"
      content={pageTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonical}
    />

    <!-- Twitter / X Cards -->

    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content={pageTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <!-- Favicon -->

    <link
      rel="icon"
      type="image/svg+xml"
      href={internalPath('favicon.svg')}
    />
  </head>

  <body>
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
